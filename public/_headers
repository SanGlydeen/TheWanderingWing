# Response headers for the deployed site.
#
# Cloudflare's default for static assets is
#   Cache-Control: public, max-age=0, must-revalidate
# which makes a returning visitor revalidate every single photograph on
# every page view. On a gallery page that is dozens of round trips before
# anything appears. The rules below cut that down.

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin

# A given derivative filename always holds the same photograph, so this can
# be cached hard. Thirty days rather than a year because the names are not
# content-hashed: if an original is ever replaced in place, this is how long
# a returning visitor could see the old frame.
/photos/*
  Cache-Control: public, max-age=2592000

# The favicon's filename carries a hash of its contents, like the CSS and
# JS, so it is safe to cache indefinitely — and changing the logo produces
# a new URL rather than leaving browsers on the old one for a month.
/img/*
  Cache-Control: public, max-age=31536000, immutable

# CSS and JS filenames carry a hash of their contents, so a change produces
# a new URL. That makes them safe to cache indefinitely, and removes the
# window where fresh HTML could be paired with a stale stylesheet or script.
/css/*
  Cache-Control: public, max-age=31536000, immutable

/js/*
  Cache-Control: public, max-age=31536000, immutable
